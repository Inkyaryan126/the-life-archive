{
  "name": "life-archive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "next lint",
    "env:check": "ts-node --transpile-only --compiler-options '{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' scripts/check-env.ts",
    "db:migrate-local": "ts-node --transpile-only --compiler-options '{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' scripts/migrate-local-to-supabase.ts",
    "advertising:generate": "npx tsx scripts/generate-advertising-assets.ts",
    "test": "set -e; for test_file in tests/*.test.ts; do ts-node --transpile-only --compiler-options '{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' \"$test_file\"; done"
  },
  "dependencies": {
    "@fontsource/noto-sans-mono": "^5.2.10",
    "@fontsource/noto-serif": "^5.2.9",
    "@js-temporal/polyfill": "^0.5.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "jsqr": "^1.4.0",
    "next": "^15.5.16",
    "opentype.js": "^2.0.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-pageflip": "^2.0.3",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "20.14.9",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "^15.5.16",
    "postcss": "8.5.10",
    "tailwindcss": "3.4.4",
    "ts-node": "^10.9.2",
    "typescript": "5.5.2"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
