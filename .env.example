NEXT_PUBLIC_SITE_URL=https://thelifearchive.vip
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
USE_SUPABASE=true
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ADMIN_EMAILS=you@example.com
RESEND_API_KEY=your-resend-api-key
TLA_FROM_EMAIL="The Life Archive <hello@thelifearchive.vip>"
CRON_SECRET=replace-with-a-random-cron-secret

# Stripe Configuration
# Set STRIPE_MODE to "test" for development or "live" for production.
# Test mode Price IDs (starting with price_) must be used with sk_test_ keys.
# Live mode Price IDs (starting with price_) must be used with sk_live_ keys.
STRIPE_MODE=test
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Official Stripe Price IDs (must start with price_)
STRIPE_PRICE_MEMBER_CARD=price_replace_me
STRIPE_PRICE_MEMORIAL_CARD=price_replace_me
STRIPE_PRICE_MEMORIAL_KEYCHAIN=price_replace_me
STRIPE_PRICE_MEMORIAL_DOG_TAG=price_replace_me
STRIPE_PRICE_MEMORIAL_PLAQUE=price_replace_me
